# Usado SOMENTE no `pnpm dev`: destino do rewrite /api/* -> API FastAPI.
# No cluster, o ingress Traefik faz esse roteamento e esta variável não é necessária.
# Não use o prefixo NEXT_PUBLIC_: a URL interna não deve ir para o bundle do navegador.
API_INTERNAL_URL=http://localhost:8000

# Desativa a telemetria do Next.js (ambiente on-premises).
NEXT_TELEMETRY_DISABLED=1

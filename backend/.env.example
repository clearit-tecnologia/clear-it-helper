# Copy to .env for local development. Never commit real secrets.
CH_ENV=dev
CH_LOG_LEVEL=INFO

# postgresql:// is converted to postgresql+asyncpg:// automatically
CH_DATABASE_URL=postgresql://clearhelper:change-me@localhost:5432/clearhelper
CH_REDIS_URL=redis://localhost:6379/0
CH_QDRANT_URL=http://localhost:6333

CH_S3_ENDPOINT=http://localhost:3900
CH_S3_ACCESS_KEY=
CH_S3_SECRET_KEY=
CH_S3_BUCKET=clear-helper-docs
CH_S3_REGION=garage

CH_LITELLM_URL=http://localhost:4000
CH_LITELLM_API_KEY=

# Optional
CH_LANGFUSE_HOST=
CH_LANGFUSE_PUBLIC_KEY=
CH_LANGFUSE_SECRET_KEY=

# At least 32 characters, e.g. `openssl rand -hex 32`
CH_JWT_SECRET=
CH_JWT_EXPIRES_MINUTES=60

CH_BOOTSTRAP_TENANT=ClearIT
CH_BOOTSTRAP_ADMIN_EMAIL=admin@clearit.local
CH_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated list
CH_CORS_ORIGINS=http://clear-helper.localhost

# Per-check timeout for /health/ready (seconds)
CH_HEALTH_TIMEOUT_SECONDS=2

# Phase 1: baseline RAG (docs/arquitetura/fase-1-contrato.md)
CH_LLM_MODEL=qwen3
CH_LLM_TIMEOUT_SECONDS=300
CH_EMBEDDING_MODEL=bge-m3
CH_EMBEDDING_DIM=1024
# The collection name identifies the strategy version: new embedding model or chunking => new collection
CH_QDRANT_COLLECTION=chunks_baseline_v1
CH_CHUNK_SIZE=1000
CH_CHUNK_OVERLAP=200
CH_RETRIEVAL_TOP_K=5
CH_RETRIEVAL_MIN_SCORE=0.35
CH_UPLOAD_MAX_MB=50
